HNG_PORT=8443
HNG_DB=./data/hng.db
HNG_TLS_CERT=./data/dev-cert.pem
HNG_TLS_KEY=./data/dev-key.pem
HNG_ORIGIN=https://localhost:8443
HNG_AI_PROVIDER=claude
HNG_AI_KEY=
HNG_AI_MODEL=claude-sonnet-4-20250514
# Đặt 1 để chạy HTTP localhost khi chưa có cert (Origin cũng phải http://...)
HNG_DEV_HTTP=0
HNG_BACKUP_DIR=./data/backup
# Bể cá: hết giờ tab đang mở / tab ẩn / báo trước (ms). Rút ngắn khi test.
